# ─── DWP's own Supabase project ──────────────────────────────────────
# DWP is a standalone product with its own Supabase instance.
# Michael creates this project in the Supabase dashboard, then fills the
# values below. The project ref appears in the Supabase URL.

VITE_DWP_SUPABASE_URL=https://<dwp-project-ref>.supabase.co
VITE_DWP_SUPABASE_ANON_KEY=<dwp-publishable-anon-key>

# Public site URL (used for OAuth redirects and Route A hash-token detection)
VITE_PUBLIC_SITE_URL=https://dailywrite.wrife.co.uk

# wrife.co.uk hub URL — used by the ← WriFe back button when entry is via Route A
VITE_WRIFE_HUB_URL=https://wrife.co.uk

# wrife.co.uk's Supabase project (separate from DWP's) — only used by the
# integration bridge Edge Function that mints DWP sessions for school pupils
# arriving via SSO. Not used by client code.
WRIFE_HUB_SUPABASE_URL=https://gzmgjkbtsvezfclmreru.supabase.co
WRIFE_HUB_SUPABASE_JWT_SECRET=<from wrife.co.uk Supabase settings>

# Server-only — set in Vercel project, NOT in client env
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
