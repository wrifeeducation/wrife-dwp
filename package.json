{
  "name": "wrife-dwp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WriFe Daily Writing Practice \u2014 sub-app for the WriFe brand. dailywrite.wrife.co.uk",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "supabase:types": "supabase gen types typescript --project-id $DWP_SUPABASE_PROJECT_REF --schema public > src/types/supabase.ts",
    "audio:generate": "tsx --env-file=.env scripts/generate-audio.ts",
    "check-env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "framer-motion": "^11.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "@types/node": "^20.14.0"
  }
}